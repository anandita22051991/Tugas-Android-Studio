<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/edBiodataMahasiswa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textSize="20sp"
        android:textAlignment="center"
        android:text="BIODATA MAHASISWA"
        android:textStyle="bold"
        android:textColor="#87CEFA" />

    <EditText
        android:id="@+id/edNIM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:hint="Masukan NIM" />
    <EditText
        android:id="@+id/edNama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukan Nama" />
    <EditText
        android:id="@+id/edIPK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukan IPK"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jurusan"
        />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" >

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:layout_width="188dp"
                    android:layout_height="wrap_content"
                    android:text="S1 Ilmu Komputer" />

                <RadioButton
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:text="S1 Sains Data" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kelas" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <CheckBox
                        android:layout_width="172dp"
                        android:layout_height="wrap_content"
                        android:text="4IKRA" />

                    <CheckBox
                        android:layout_width="242dp"
                        android:layout_height="wrap_content"
                        android:text="4DSRA" />

        </LinearLayout>
                <Button
                    android:id="@+id/ednext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NEXT"
                    android:backgroundTint="#2874A3" />
  </LinearLayout>